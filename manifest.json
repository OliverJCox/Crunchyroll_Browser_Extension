{
  "manifest_version": 3,
  "name": "Crunchyroll Streaming Analyser",
  "version": "1.0.0",
  "description": "Analyses and visualises your Crunchyroll watch history and streaming patterns.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Analyse Crunchyroll History"
  },
  "host_permissions": [
    "https://*.crunchyroll.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "crunchyroll-analyser@crunchyrollanalyserextension.com",
      "strict_min_version": "109.0"
    }
  }
}
